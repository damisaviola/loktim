generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Company {
  id         String  @id @default(cuid())
  authUserId String? @unique
  name       String
  location   String
  logoUrl    String?
  email      String?
  about      String?
  picName    String?
  jobs       Job[]
}

model Job {
  id           String   @id @default(cuid())
  title        String
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  type         String
  category     String
  education    String
  experience   String
  gender       String
  ageRange     String
  salaryMin    Int?
  salaryMax    Int?
  isPremium    Boolean  @default(false)
  status       String?  @default("pending")
  postedAt     DateTime @default(now())
  location     String?
  description  String
  requirements String[]
  picName      String?
  contactUrl   String
  contacts     Json?
  imageUrl     String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deadline     DateTime?
  reports      JobReport[]
}

model Admin {
  id         String   @id @default(cuid())
  authUserId String?  @unique
  username   String   @unique
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model JobReport {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason    String
  details   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id           String   @id @default(cuid())
  ticketId     String   @unique
  name         String
  email        String
  phone        String?
  organization String?
  category     String   @default("general")
  subject      String
  message      String
  status       String   @default("unread") // unread, read, replied, archived
  replyNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

